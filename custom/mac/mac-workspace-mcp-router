#!/usr/bin/env bash
# Start mac-workspace-mcp rooted at the Mac folder mapped to a server folder.
#   mac-workspace-mcp-router --remote-root /home/claude/projects/app
# The map is projects.conf (WORKSPACE_PROJECTS, default ~/.config/claudemax/projects.conf): one
# `mac_folder|server_folder[|...]` per line, the same file CC Desk Tunnel's CCDT_PROJECT_MAP is built from.
# The longest server folder containing the path wins; a subfolder maps to the same subfolder.
set -euo pipefail
CONFIG=${WORKSPACE_PROJECTS:-$HOME/.config/claudemax/projects.conf}
REMOTE_ROOT=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote-root) REMOTE_ROOT=${2:-}; shift 2 ;;
    *) echo "usage: mac-workspace-mcp-router --remote-root /server/folder" >&2; exit 2 ;;
  esac
done
[[ -n "$REMOTE_ROOT" ]] || { echo "missing --remote-root" >&2; exit 2; }
[[ -r "$CONFIG" ]] || { echo "missing $CONFIG" >&2; exit 1; }

best_remote=''
best_local=''
while IFS='|' read -r local_root remote_root _; do
  [[ -n "${local_root:-}" && "$local_root" != \#* ]] || continue
  case "$REMOTE_ROOT" in
    "$remote_root"|"$remote_root"/*)
      if [[ ${#remote_root} -gt ${#best_remote} ]]; then
        best_remote=$remote_root
        best_local=$local_root
      fi
      ;;
  esac
done < "$CONFIG"

[[ -n "$best_remote" ]] || { echo "unmapped server folder: $REMOTE_ROOT" >&2; exit 1; }
exec "$HOME/.local/bin/mac-workspace-mcp" --root "${best_local}${REMOTE_ROOT#"$best_remote"}"

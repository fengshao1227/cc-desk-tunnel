#!/usr/bin/env bash
# Claude Code Notification hook: show a macOS notification on the Mac named by NOTIFY_HOST (an ssh alias) when a
# session waits for the user (idle_prompt after ~60 s, permission_prompt after
# ~6 s). Claude Code only fires these while the user seems away from the
# terminal, so this does not pop up during an attended session.
#
# Text reaches osascript as argv, never inside the script source, so quotes or
# backslashes in a message cannot break out. Runs detached and bounded: a
# closed lid or a dropped tunnel just means no notification.
set -uo pipefail
TARGET=${NOTIFY_HOST:-}
[ -n "$TARGET" ] || exit 0   # set NOTIFY_HOST to the ssh alias of the Mac to notify

payload=$(cat)
read -r kind message < <(printf '%s' "$payload" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d.get("notification_type") or "notice", (d.get("message") or "").replace("\n", " ")[:200])
' 2>/dev/null) || exit 0

project=$(basename "${CLAUDE_PROJECT_DIR:-$PWD}")
case "$kind" in
  idle_prompt) title="Claude 完成了 · $project" ;;
  permission_prompt) title="Claude 等你审批 · $project" ;;
  *) title="Claude · $project" ;;
esac

(
  timeout 15 ssh -F "$HOME/.ssh/config" -o BatchMode=yes -o ConnectTimeout=5 "$TARGET" \
    /usr/bin/osascript -e "'on run argv'" \
    -e "'display notification (item 2 of argv) with title (item 1 of argv) sound name \"Glass\"'" \
    -e "'end run'" "$(printf '%q' "$title")" "$(printf '%q' "${message:-$kind}")" \
    >/dev/null 2>&1
) </dev/null &
exit 0

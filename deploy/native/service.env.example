# Service configuration (node --env-file). install.sh fills the @...@ values. Keep this file 0600:
# PROXY_TOKEN is full control of this server and of every computer connected to it.
PROXY_ADAPTER='claude-code'
PROXY_TOKEN='@TOKEN@'
PROXY_HOST='0.0.0.0'
PROXY_PORT='@PORT@'
PROXY_TLS_MODE='direct'
PROXY_TLS_CERT='@HOME@/.config/cc-desk-tunnel/tls/control.crt'
PROXY_TLS_KEY='@HOME@/.config/cc-desk-tunnel/tls/control.key'
PROXY_CERT_NAME='cc-desk-tunnel.local'
PROXY_DATA_DIR='@HOME@/.local/share/cc-desk-tunnel/state'
CLAUDE_CONTEXT_RETENTION_DAYS='3650'
# The CLI the sessions run: the same one the user's shell runs, so the login and ~/.claude are shared.
CLAUDE_PATH='@CLAUDE@'

# --- Fork additions (unset = upstream behaviour) ---
# New sessions, and sessions on upstream's default `auto`, run in this approval mode.
CCDT_DEFAULT_PERMISSION_MODE='bypassPermissions'
# Device prompt template (placeholders {{device}} {{project}} {{script}} {{command}} {{session}}).
CCDT_DEVICE_PROMPT='@HOME@/.config/cc-desk-tunnel/device-prompt.md'
# device_folder|server_folder rows: a project's sessions share that server folder with plain `claude`.
CCDT_PROJECT_MAP='@HOME@/.config/cc-desk-tunnel/projects.conf'
